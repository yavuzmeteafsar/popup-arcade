{
  "manifest_version": 3,
  "name": "Popup Arcade",
  "version": "1.0.0",
  "description": "Classic mini games right in your toolbar popup.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Popup Arcade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
